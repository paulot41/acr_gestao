# ACR Gestão - Variáveis de Ambiente Local (Docker Desktop)
# Copie este ficheiro para .env.local se necessário:
#   cp .env.local.example .env.local

SECRET_KEY=django-insecure-dev-key-for-local-testing-only-12345
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Base de Dados PostgreSQL (Local Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=acrdb_local
DB_USER=acruser
DB_PASSWORD=acrpass123
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=acrdb_local
POSTGRES_USER=acruser
POSTGRES_PASSWORD=acrpass123

# Cache Redis e Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# Desativar SSL em desenvolvimento local
SECURE_SSL_REDIRECT=0
