# ACR Gestão - Variáveis de Ambiente de Produção (Servidor Próprio)
# Copie este ficheiro para .env.prod e configure os valores adequados:
#   cp .env.prod.example .env.prod

# Chave secreta do Django (gere uma chave forte, ex: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=substituir-por-chave-secreta-longa-e-aleatoria

# Modo de depuração (0 = False em produção)
DEBUG=0

# Hosts permitidos (separados por vírgula)
# Ex: gestao.acrbasto.pt,192.168.1.100
ALLOWED_HOSTS=localhost,127.0.0.1,gestao.acrbasto.pt

# Redirecionamento SSL (1 = Ativo, use 0 se estiver a testar sem SSL inicialmente)
SECURE_SSL_REDIRECT=0

# Base de Dados PostgreSQL
POSTGRES_DB=acrdb
POSTGRES_USER=acruser
POSTGRES_PASSWORD=alterar_para_password_forte_da_bd

DB_NAME=acrdb
DB_USER=acruser
DB_PASSWORD=alterar_para_password_forte_da_bd
DB_HOST=db
DB_PORT=5432

# Redis Cache
REDIS_URL=redis://redis:6379/1
